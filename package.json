{
   "name": "monorepo",
   "private": "true",
   "workspaces": [
      "packages/*"
   ],
   "type": "module",
   "scripts": {
      "bifrost": "cd packages/huginn-bifrost && bun start",
      "server": "cd packages/huginn-server && bun start",
      "cdn": "cd packages/huginn-cdn && bun start",
      "voice": "cd packages/huginn-voice && npm run start"
   },
   "dependencies": {
      "slate-dom": "^0.123.0"
   },
   "devDependencies": {
      "@biomejs/biome": "2.0.6",
      "@prettier/plugin-oxc": "^0.1.3",
      "@types/bun": "latest",
      "oxfmt": "^0.40.0",
      "oxlint": "^1.55.0",
      "prettier": "^3.8.1",
      "prettier-plugin-tailwindcss": "^0.7.2",
      "release-please": "^16.18.0",
      "typescript": "^5.9.3"
   },
   "trustedDependencies": [
      "electron",
      "prisma",
      "sharp",
      "wrtc"
   ]
}
