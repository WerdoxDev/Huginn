   "rewrites": [
      {
         "source": "/app/:path*",
         "destination": "https://huginn-app-werdoxs-projects.vercel.app/:path*"
      },
      {
         "source": "/docs/:path*",
         "destination": "https://YOUR-DOCS-PROJECT.vercel.app/:path*"
      },
      {
         "source": "/:path*",
         "destination": "https://huginn-website-werdoxs-projects.vercel.app/:path*"
      }
   ]
}
