generator client {
   provider = "prisma-client"
   output   = "./generated"
}

datasource db {
   provider = "postgresql"
}

model User {
   id          BigInt    @id
   username    String    @unique
   displayName String?
   email       String    @unique
   avatar      String?
   bannerColor String?
   password    String?
   flags       Int       @db.SmallInt
   system      Boolean   @default(false)
   createdAt   DateTime  @default(now())
   updatedAt   DateTime? @updatedAt

   includedChannels        Channel[]           @relation("channel_recipients")
   ownedChannels           Channel[]           @relation("channel_owner")
   tempDeletedChannels     Channel[]           @relation("channel_temp_deleted")
   messages                Message[]
   mentionedMessages       Message[]           @relation("message_mentions")
   relationships           Relationship[]      @relation("relation_owner")
   relatedRelationships    Relationship[]      @relation("relation_user")
   identityProvider        IdentityProvider[]
   readStates              ReadState[]
   participatedCalls       Call[]              @relation("participated_calls")
   settings                Settings?
   contributedApplications KnownApplication[]
   emailVerifications      EmailVerification[]
}

model EmailVerification {
   id        BigInt   @id
   user      User     @relation(fields: [userId], references: [id])
   userId    BigInt   @unique
   newEmail  String
   code      String
   expiresAt DateTime
   createdAt DateTime @default(now())
}

model IdentityProvider {
   id             BigInt  @id
   providerUserId String  @unique
   userId         BigInt?
   completed      Boolean
   providerType   String
   refreshToken   String

   user User? @relation(fields: [userId], references: [id])
}

model Channel {
   id                BigInt             @id
   icon              String?
   lastMessageId     BigInt?
   name              String?
   ownerId           BigInt?
   type              Int
   messages          Message[]
   readStates        ReadState[]
   messageReferences MessageReference[]
   createdAt         DateTime           @default(now())
   updatedAt         DateTime?          @updatedAt

   lastMessage        Message? @relation("channel_last_message", fields: [lastMessageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
   owner              User?    @relation("channel_owner", fields: [ownerId], references: [id])
   recipients         User[]   @relation("channel_recipients")
   tempDeletedByUsers User[]   @relation("channel_temp_deleted")

   @@index([type])
}

model Message {
   id                  BigInt       @id
   authorId            BigInt
   channelId           BigInt
   content             String
   timestamp           DateTime
   editedTimestamp     DateTime?
   deletedTimestamp    DateTime?
   embeds              Embed[]
   attachments         Attachment[]
   reactions           String[]
   call                Call?
   pinned              Boolean
   type                Int
   flags               Int          @db.SmallInt
   lastReadMessages    ReadState[]
   lastMessageChannels Channel[]    @relation("channel_last_message")

   author            User               @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
   channel           Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
   mentions          User[]             @relation("message_mentions")
   messageReference  MessageReference?  @relation("message_referrer")
   referringMessages MessageReference[] @relation("message_reference")

   @@index([channelId])
}

model Call {
   id             BigInt    @id
   messageId      BigInt    @unique
   endedTimestamp DateTime?

   message      Message @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
   participants User[]  @relation("participated_calls")
}

model Relationship {
   id        BigInt    @id
   type      Int       @db.SmallInt
   nickname  String
   since     DateTime?
   ownerId   BigInt
   userId    BigInt
   createdAt DateTime  @default(now())
   updatedAt DateTime? @updatedAt

   owner User @relation("relation_owner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
   user  User @relation("relation_user", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

   @@index([ownerId])
}

model ReadState {
   channelId         BigInt
   userId            BigInt
   lastReadMessageId BigInt?

   channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
   user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
   lastReadMessage Message? @relation(fields: [lastReadMessageId], references: [id], onDelete: SetNull, onUpdate: Cascade)

   @@id([channelId, userId])
}

model Embed {
   id          BigInt     @id
   title       String?
   type        String
   description String?
   url         String?
   timestamp   DateTime?
   messageId   BigInt?
   thumbnail   Thumbnail?
   video       Video?

   message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Thumbnail {
   id      BigInt @id
   width   Int
   height  Int
   url     String
   embedId BigInt @unique

   embed Embed @relation(fields: [embedId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Video {
   id      BigInt @id
   width   Int
   height  Int
   url     String
   embedId BigInt @unique

   embed Embed @relation(fields: [embedId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Attachment {
   id          BigInt  @id
   filename    String
   description String?
   contentType String
   size        Int
   url         String
   width       Int?
   height      Int?
   flags       Int     @db.SmallInt
   messageId   BigInt?

   message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Settings {
   userId BigInt @id @unique
   json   Json

   user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model KnownApplication {
   id                  Int       @id @default(autoincrement())
   names               String[]
   exeName             String
   igdbId              Int?
   contributorId       BigInt?
   createdAt           DateTime  @default(now())
   updatedAt           DateTime? @updatedAt
   deletedAt           DateTime?
   commandLinePatterns String[]
   active              Boolean   @default(false)

   contributor User? @relation(fields: [contributorId], references: [id])

   @@index([names])
}

model MessageReference {
   id                BigInt  @id
   type              Int
   referrerMessageId BigInt  @unique
   messageId         BigInt?
   channelId         BigInt

   referrerMessage Message  @relation("message_referrer", fields: [referrerMessageId], references: [id], onDelete: Cascade)
   message         Message? @relation("message_reference", fields: [messageId], references: [id])
   channel         Channel  @relation(fields: [channelId], references: [id])

   @@index([referrerMessageId])
}
