{
   "name": "@huginn/backend-shared",
   "version": "0.31.2",
   "private": true,
   "type": "module",
   "module": "src/index.ts",
   "imports": {
      "#database": "./src/database/index.ts",
      "#*": "./src/*.ts",
      "#types": "./src/types.ts",
      "#prisma/*": "./prisma/generated/*.ts"
   },
   "exports": {
      ".": "./src/index.ts",
      "./*": "./src/*.ts",
      "./database": "./src/database/index.ts",
      "./types": "./src/types.ts"
   },
   "dependencies": {
      "@huginnjs/shared": "workspace:*",
      "@neondatabase/serverless": "^1.1.0",
      "@prisma/adapter-neon": "^7.10.0",
      "@prisma/adapter-pg": "^7.10.0",
      "@prisma/client": "7.10.0",
      "better-drizzle": "^0.1.1",
      "dotenv": "^17.4.2",
      "drizzle-kit": "^0.31.10",
      "drizzle-orm": "^0.45.2",
      "elysia-rate-limit": "^4.6.3",
      "jose": "^6.2.10",
      "mediabunny": "^1.55.2",
      "pathe": "^2.0.3",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "sharp": "^0.35.4"
   },
   "devDependencies": {
      "@elysia/opentelemetry": "^1.4.12",
      "@types/bun": "1.4.0",
      "@types/pg": "^8.23.1",
      "crossws": "^0.4.12",
      "elysia": "1.4.29",
      "prisma": "7.8.0"
   }
}
