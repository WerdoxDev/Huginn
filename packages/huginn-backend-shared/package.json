{
   "name": "@huginn/backend-shared",
   "version": "0.28.1",
   "type": "module",
   "imports": {
      "#database": "./src/database/index.ts",
      "#*": "./src/*.ts",
      "#types": "./src/types.ts",
      "#prisma/*": "./prisma/generated/*.ts"
   },
   "exports": {
      ".": "./src/index.ts",
      "./*": "./src/*.ts",
      "./database": "./src/database/index.ts",
      "./types": "./src/types.ts"
   },
   "dependencies": {
      "@huginn/shared": "workspace:*",
      "@prisma/adapter-pg": "^7.7.0",
      "@prisma/client": "7.8.0",
      "dotenv": "^17.4.2",
      "elysia-rate-limit": "^4.5.1",
      "jose": "^6.1.3",
      "mediabunny": "^1.49.0",
      "pathe": "^2.0.3",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "sharp": "^0.35.2"
   },
   "devDependencies": {
      "@elysia/opentelemetry": "^1.4.12",
      "@types/bun": "1.3.14",
      "@types/pg": "^8.16.0",
      "crossws": "^0.4.6",
      "elysia": "^1.4.29",
      "prisma": "7.8.0"
   },
   "module": "src/index.ts",
   "private": true
}
