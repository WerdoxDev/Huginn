{
   "name": "@huginn/backend-shared",
   "version": "0.25.1",
   "type": "module",
   "imports": {
      "#database": "./src/database/index.ts",
      "#*": "./src/*.ts",
      "#types": "./src/types.ts",
      "#prisma/*": "./prisma/generated/*.ts"
   },
   "exports": {
      ".": "./src/index.ts",
      "./*": "./src/*.ts",
      "./database": "./src/database/index.ts",
      "./types": "./src/types.ts"
   },
   "dependencies": {
      "@huginn/shared": "workspace:*",
      "@prisma/adapter-pg": "^7.7.0",
      "@prisma/client": "7.7.0",
      "@prisma/extension-optimize": "^2.0.1",
      "elysia-rate-limit": "^4.5.1",
      "jose": "^6.1.3",
      "mediabunny": "^1.40.1",
      "sharp": "^0.33.5"
   },
   "devDependencies": {
      "@types/bun": "1.3.12",
      "@types/pg": "^8.16.0",
      "crossws": "^0.4.5",
      "elysia": "^1.4.28",
      "prisma": "7.7.0"
   }
}
