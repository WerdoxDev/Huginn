{
   "name": "@huginn/backend-shared",
   "version": "0.22.1",
   "type": "module",
   "dependencies": {
      "@elysiajs/bearer": "^1.4.1",
      "@huginn/shared": "workspace:*",
      "@prisma/adapter-pg": "^7.2.0",
      "@prisma/client": "7",
      "@prisma/extension-optimize": "^2.0.1",
      "jose": "^6.1.3",
      "mediabunny": "^1.27.1",
