{
   "name": "@huginn/server",
   "version": "0.50.0",
   "type": "module",
   "imports": {
      "#*": "./src/*.ts"
   },
   "scripts": {
      "dev": "bun run --hot --preload ./src/setup.ts ./src/run.ts",
