{
   "name": "@huginn/voice",
   "version": "0.19.1",
   "type": "module",
   "imports": {
      "#*": "./src/*.ts"
   },
   "scripts": {
      "start": "node --import=tsx --experimental-loader=@opentelemetry/instrumentation/hook.mjs ./src/setup.ts",
      "dev": "node --import=tsx --watch --experimental-loader=@opentelemetry/instrumentation/hook.mjs ./src/setup.ts",
      "bun-dev": "bun ./src/index.ts"
   },
   "dependencies": {
      "@huginn/backend-shared": "workspace:*",
      "@huginn/runtime-shared": "workspace:*",
      "@huginn/shared": "workspace:*",
      "@opentelemetry/instrumentation": "^0.218.0",
      "crossws": "^0.4.6",
      "dotenv": "^17.4.2",
      "elysia": "^1.4.29",
      "envalid": "^8.2.0",
      "mediasoup": "^3.21.0",
      "srvx": "^0.11.17"
   },
   "devDependencies": {
      "@types/node": "^26.0.1",
      "tsx": "^4.21.0"
   },
   "trustedDependencies": [
      "mediasoup"
   ]
}
