{
   "name": "huginn-app-react",
   "version": "0.86.0",
   "description": "Huginn Desktop Application",
   "author": {
      "name": "Matin Tat",
      "email": "matin.tat85@gmail.com",
      "url": "https://github.com/WerdoxDev"
   },
   "repository": {
      "url": "https://github.com/WerdoxDev/Huginn"
   },
   "type": "module",
   "main": "./.electron/main.mjs",
   "scripts": {
      "dev": "bun ./scripts/dev.ts",
      "preview": "vite preview",
      "build": "bun run vite:build --mode electron && bun run electron:build",
      "vite:dev": "vite --host --port 5174",
      "vite:electron": "vite --host --port 5174 --mode electron",
      "vite:build": "vite build",
      "vite:build-cap": "vite build --mode capacitor && cap sync",
      "electron:build": "bun ./scripts/build.ts --prod && electron-builder --config ./electron-builder-config.ts",
      "electron:run": "bun ./scripts/build.ts && electron .",
      "build:fast": "bun run vite:build && bun ./scripts/build.ts && electron-builder --config ./electron-builder-config.ts -c.compression=store",
      "p-test": "playwright test",
      "test": "vitest --coverage",
      "test-gen": "playwright codegen localhost:5174",
      "electron:rebuild": "electron-rebuild -f -v 42.5.0 -m native-addon",
      "vite:cap": "adb reverse tcp:5174 tcp:5174 && bunx cap sync && vite --host --port 5174 --mode capacitor",
      "cap:release-build": "bun run vite:build-cap && cd android && ./gradlew assembleRelease",
      "cap:debug-build": "bun run vite:build-cap && cd android && ./gradlew assembleDebug",
      "cap:run": "cap run android",
      "cap:live": "cap run android --live-reload --port 5174",
      "cap:open": "cap open android",
      "cap:dev": "bun run --parallel vite:cap cap:live",
      "serve-updates:android": "adb reverse tcp:8080 tcp:8080 && bunx serve ./android-releases/ -p 8080"
   },
   "dependencies": {
      "@base-ui/react": "^1.6.0",
      "@capacitor/android": "^8.4.1",
      "@capacitor/app": "^8.1.0",
      "@capacitor/core": "^8.4.1",
      "@capacitor/device": "^8.0.2",
      "@capacitor/filesystem": "^8.1.2",
      "@capacitor/push-notifications": "^8.1.1",
      "@capawesome/capacitor-live-update": "^8.3.0",
      "@chenglou/pretext": "^0.0.7",
      "@headlessui/react": "^2.2.9",
      "@huginnjs/api": "workspace:*",
      "@huginnjs/shared": "workspace:*",
      "@posthog/rollup-plugin": "^1.4.7",
      "@rolldown/plugin-babel": "^0.2.3",
      "@svgr/core": "^8.1.0",
      "@tanstack/query-broadcast-client-experimental": "^5.101.4",
