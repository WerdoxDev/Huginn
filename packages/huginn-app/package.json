{
   "name": "huginn-app-react",
   "version": "0.70.0",
   "description": "Huginn Desktop Application",
   "author": {
      "name": "Matin Tat",
      "email": "matin.tat85@gmail.com",
      "url": "https://github.com/WerdoxDev"
   },
   "repository": {
      "url": "https://github.com/WerdoxDev/Huginn"
   },
   "type": "module",
   "main": "./.electron/main.mjs",
   "scripts": {
      "dev": "bun ./scripts/dev.ts",
      "preview": "vite preview",
      "build": "bun run vite:build --mode electron && bun run electron:build",
      "vite:dev": "vite --host --port 5174",
      "vite:build": "vite build",
      "vite:build-cap": "vite build --mode capacitor && cap sync",
      "electron:build": "bun ./scripts/build.ts --prod && electron-builder --config ./electron-builder-config.ts",
      "electron:run": "bun ./scripts/build.ts && electron .",
      "build:fast": "bun run vite:build && bun ./scripts/build.ts && electron-builder --config ./electron-builder-config.ts -c.compression=store",
      "test": "playwright test",
      "test-gen": "playwright codegen localhost:5174",
      "electron:rebuild": "electron-rebuild -f -v 42.2.0 -m native-addon",
      "vite:cap": "vite --host --port 5174 --mode capacitor",
      "cap:release-build": "bun run vite:build-cap && cd android && ./gradlew assembleRelease",
      "cap:debug-build": "bun run vite:build-cap && cd android && ./gradlew assembleDebug",
      "cap:run": "cap run android",
      "cap:live": "cap run android --live-reload --port 5174 --host 192.168.178.21",
      "cap:open": "cap open android",
      "cap:dev": "bun run --parallel vite:cap cap:live"
   },
   "dependencies": {
      "@base-ui/react": "^1.5.0",
      "@capacitor/android": "^8.3.4",
      "@capacitor/app": "^8.1.0",
      "@capacitor/core": "^8.3.4",
      "@chenglou/pretext": "^0.0.7",
      "@headlessui/react": "^2.2.9",
      "@huginn/api": "workspace:*",
      "@huginn/shared": "workspace:*",
      "@rolldown/plugin-babel": "^0.2.3",
      "@tanstack/react-query": "^5.100.11",
      "@tanstack/react-router": "^1.170.7",
      "@tanstack/react-router-devtools": "^1.167.0",
      "animejs": "^4.4.1",
      "application-loopback": "1.2.7",
      "blobs": "^2.3.0-beta.2",
      "clsx": "^2.1.1",
      "electron-log": "^5.4.4",
      "electron-updater": "^6.6.2",
      "highlight.js": "^11.11.1",
      "immer": "^10.2.0",
      "jose": "^5.10.0",
      "markdown-it": "^14.1.0",
      "moment": "^2.30.1",
      "motion": "^11.18.2",
      "native-addon": "workspace:*",
      "posthog-js": "^1.375.0",
      "react": "^19.2.0",
      "react-cropper": "^2.3.3",
      "react-dom": "^19.2.0",
      "react-error-boundary": "^6.1.1",
      "react-hook-form": "^7.76.0",
      "sharp": "^0.34.4",
      "slate": "^0.124.1",
      "slate-react": "^0.124.2",
      "super-image-cropper": "^1.0.27",
      "zod": "^4.4.3",
      "zustand": "^5.0.13"
   },
   "devDependencies": {
      "@capacitor/cli": "^8.3.4",
      "@babel/plugin-syntax-jsx": "^7.27.1",
      "@babel/preset-typescript": "^7.28.5",
      "@electron/rebuild": "^4.0.4",
      "@iconify/json": "^2.2.477",
      "@playwright/test": "^1.60.0",
      "@svgr/core": "^8.1.0",
      "@svgr/plugin-jsx": "^8.1.0",
      "@tailwindcss/vite": "^4.3.0",
      "@tanstack/react-query-devtools": "^5.90.2",
      "@tanstack/router-plugin": "^1.168.10",
      "@types/bun": "latest",
      "@types/markdown-it": "^14.1.2",
      "@types/react": "^19.2.2",
      "@types/react-dom": "^19.2.2",
      "@vite-pwa/assets-generator": "^1.0.2",
      "@vitejs/plugin-basic-ssl": "^2.1.0",
      "@vitejs/plugin-react": "^6.0.2",
      "babel-plugin-react-compiler": "^1.0.0",
      "dotenv": "^17.2.3",
      "electron": "42.2.0",
      "electron-builder": "^26.0.12",
      "mediasoup-client": "^3.20.0",
      "tailwindcss": "^4.1.16",
      "tsdown": "^0.22.0",
      "typescript": "^6.0.3",
      "unplugin-auto-import": "^21.0.0",
      "unplugin-icons": "^23.0.1",
      "vite": "^8.0.14",
      "vite-plugin-pwa": "^1.3.0",
      "workbox-core": "^7.4.0"
   },
   "cmake-js": {
      "runtime": "electron",
      "runtimeVersion": "42.2.0",
      "arch": "x64"
   }
}
