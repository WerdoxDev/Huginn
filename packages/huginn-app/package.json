      "moment": "^2.30.1",
      "motion": "^12.41.0",
      "native-addon": "workspace:*",
      "posthog-js": "^1.393.4",
      "posthog-node": "^5.38.5",
      "react": "^19.2.7",
      "react-cropper": "^2.3.3",
      "react-dom": "^19.2.7",
      "react-error-boundary": "^6.1.1",
      "react-hook-form": "^7.80.0",
      "semver-ts": "^1.0.3",
      "slate": "^0.126.0",
