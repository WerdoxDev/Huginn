      "@tanstack/react-virtual": "^3.14.9",
      "animejs": "^4.5.0",
      "blobs": "^2.3.0-beta.2",
      "capacitor-native-settings": "^8.1.0",
      "clsx": "^2.1.1",
      "electron-log": "^5.4.4",
