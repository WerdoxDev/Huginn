{
   "name": "huginn-app-react",
   "version": "0.68.1",
   "description": "Huginn Desktop Application",
   "author": {
      "name": "Matin Tat",
      "email": "matin.tat85@gmail.com",
      "url": "https://github.com/WerdoxDev"
   },
   "repository": {
      "url": "https://github.com/WerdoxDev/Huginn"
   },
   "type": "module",
   "main": "./.electron/main.mjs",
   "scripts": {
      "dev": "bun ./scripts/dev.ts",
      "preview": "vite preview",
      "build": "bun run vite:build --mode electron && bun run electron:build",
      "vite:dev": "vite --host --port 5174",
      "vite:build": "vite build",
      "electron:build": "bun ./scripts/build.ts --prod && electron-builder --config ./electron-builder-config.ts",
      "electron:run": "bun ./scripts/build.ts && electron .",
      "build:fast": "bun run vite:build && bun ./scripts/build.ts && electron-builder --config ./electron-builder-config.ts -c.compression=store",
      "test": "playwright test",
      "test-gen": "playwright codegen localhost:5174",
      "electron:rebuild": "electron-rebuild -f -v 36.3.2 -m native-addon"
   },
   "dependencies": {
      "@base-ui/react": "^1.4.1",
      "@chenglou/pretext": "^0.0.4",
      "@headlessui/react": "^2.2.9",
      "@huginn/api": "workspace:*",
      "@huginn/shared": "workspace:*",
      "@tanstack/react-query": "^5.90.5",
      "@tanstack/react-router": "^1.167.0",
      "@tanstack/react-router-devtools": "^1.166.7",
      "animejs": "^4.3.6",
      "application-loopback": "1.2.7",
      "blobs": "^2.3.0-beta.2",
      "clsx": "^2.1.1",
      "electron-log": "^5.4.3",
      "electron-updater": "^6.6.2",
      "highlight.js": "^11.11.1",
      "immer": "^10.2.0",
      "jose": "^5.10.0",
      "markdown-it": "^14.1.0",
      "moment": "^2.30.1",
      "motion": "^11.18.2",
      "native-addon": "workspace:*",
      "posthog-js": "^1.281.0",
      "react": "^19.2.0",
      "react-cropper": "^2.3.3",
      "react-dom": "^19.2.0",
      "react-error-boundary": "^6.1.1",
      "react-hook-form": "^7.71.0",
      "sharp": "^0.34.4",
      "slate": "^0.123.0",
      "slate-react": "^0.123.0",
      "super-image-cropper": "^1.0.27",
      "zod": "^4.3.6",
      "zustand": "^5.0.8"
   },
   "devDependencies": {
      "@babel/plugin-syntax-jsx": "^7.27.1",
      "@babel/preset-typescript": "^7.28.5",
      "@electron/rebuild": "^4.0.1",
      "@iconify/json": "^2.2.450",
      "@playwright/test": "^1.56.1",
      "@svgr/core": "^8.1.0",
      "@svgr/plugin-jsx": "^8.1.0",
      "@tailwindcss/vite": "^4.1.16",
      "@tanstack/react-query-devtools": "^5.90.2",
      "@tanstack/router-plugin": "^1.166.9",
      "@types/bun": "latest",
      "@types/markdown-it": "^14.1.2",
      "@types/react": "^19.2.2",
      "@types/react-dom": "^19.2.2",
      "@vite-pwa/assets-generator": "^1.0.2",
      "@vitejs/plugin-basic-ssl": "^2.1.0",
      "@vitejs/plugin-react": "^5.1.0",
      "babel-plugin-react-compiler": "^1.0.0",
      "dotenv": "^17.2.3",
      "electron": "36.3.2",
      "electron-builder": "^26.0.12",
      "mediasoup-client": "^3.17.1",
      "tailwindcss": "^4.1.16",
      "tsdown": "^0.20.3",
      "typescript": "^5.9.3",
      "unplugin-auto-import": "^21.0.0",
      "unplugin-icons": "^23.0.1",
      "vite": "^7.1.12",
      "vite-plugin-pwa": "^1.2.0",
      "workbox-core": "^7.4.0"
   },
   "cmake-js": {
      "runtime": "electron",
      "runtimeVersion": "36.3.2",
      "arch": "x64"
   }
}
