{
   "headers": [
      {
         "source": "/app/(.*).html",
         "headers": [
            {
               "key": "Cache-Control",
               "value": "public, max-age=0, must-revalidate"
            }
         ]
      },
      {
         "source": "/app/(.*).css",
         "headers": [
            {
               "key": "Content-Type",
               "value": "text/css"
            },
            {
               "key": "Cache-Control",
               "value": "max-age=31536000, immutable"
            }
         ]
      },
      {
         "source": "/app/(.*).js",
         "headers": [
            {
               "key": "Content-Type",
               "value": "application/javascript"
            },
            {
               "key": "Cache-Control",
               "value": "max-age=31536000, immutable"
            }
         ]
      },
      {
         "source": "/app/sw.js",
         "headers": [
            {
               "key": "Content-Type",
               "value": "application/javascript"
            },
            {
               "key": "Cache-Control",
               "value": "public, max-age=0, must-revalidate"
            }
         ]
      },
      {
         "source": "/app/manifest.webmanifest",
         "headers": [
            {
               "key": "Content-Type",
               "value": "application/manifest+json"
            }
         ]
      },
      {
         "source": "/app/assets/(.*)",
         "headers": [
            {
               "key": "Cache-Control",
               "value": "max-age=31536000, immutable"
            }
         ]
      },
      {
         "source": "/app/(.*)",
         "headers": [
            {
               "key": "X-Content-Type-Options",
               "value": "nosniff"
            },
            {
               "key": "X-Frame-Options",
               "value": "DENY"
            },
            {
               "key": "X-XSS-Protection",
               "value": "1; mode=block"
            }
         ]
      }
   ],
   "rewrites": [
      {
         "source": "/app/(.*)",
         "destination": "/app/index.html"
      }
   ]
}
