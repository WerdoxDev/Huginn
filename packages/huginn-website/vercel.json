{
   "rewrites": [
      {
         "source": "/app/:path*",
         "destination": "https:///app.huginn.dev/app/:path*"
      },
      {
         "source": "/app",
         "destination": "https://app.huginn.dev/app"
      },
      {
         "source": "/((?!app).*)",
         "destination": "/"
      }
   ]
}
