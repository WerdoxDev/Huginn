{
   "rewrites": [
      {
         "source": "/app/:path*",
         "destination": "https://project-b.vercel.app/:path*"
      },
      {
         "source": "/app",
         "destination": "https://project-b.vercel.app/"
      },
      {
         "source": "/((?!app).*)",
         "destination": "/"
      }
   ]
}
