{
   "rewrites": [
      {
         "source": "/app/:path*",
         "destination": "https://app.huginn.dev/:path*"
      },
      {
         "source": "/app/",
         "destination": "https://app.huginn.dev/"
      },
      {
         "source": "/preview/:path*",
         "destination": "https://preview.huginn.dev/:path*"
      },
      {
         "source": "/preview/",
         "destination": "https://preview.huginn.dev/"
      },
      {
         "source": "/((?!app|preview).*)",
         "destination": "/"
      }
   ]
}
