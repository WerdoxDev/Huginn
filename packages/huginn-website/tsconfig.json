{
   "extends": "../../tsconfig.json",
   "compilerOptions": {
      "types": ["unplugin-icons/types/react", "vite/client", "bun"],
      "jsx": "react-jsx",

      "paths": {
         "@stores/*": ["./src/stores/*"],
         "@components/*": ["./src/components/*"],
         "@contexts/*": ["./src/contexts/*"],
         "@hooks/*": ["./src/hooks/*"],
         "@lib/*": ["./src/lib/*"],
         "@/*": ["./src/*"]
      },
      "rootDirs": ["."]
   },

   "include": ["src/**/*.ts", "src/**/*.tsx", "auto-imports.d.ts"]
}
